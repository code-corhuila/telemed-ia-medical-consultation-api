# Environment for the medical-consultation API (Go).
# Real values are provided by the infra repo.

SERVER_PORT=8080

# PostgreSQL (shared instance, our own schema)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=telemed_ia
DB_USER=medical_consultation_app
DB_PASSWORD=change-me-in-the-infra-env
DB_SCHEMA=medical_consultation

# JWT (RS256). Same public key as every service.
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nREPLACE\n-----END PUBLIC KEY-----

# Timeouts (norm 5.3.10)
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s

DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONN_MAX_IDLE=5m
DB_CONN_MAX_LIFETIME=30m
DB_STATEMENT_TIMEOUT=5s
